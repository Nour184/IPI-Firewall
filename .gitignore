dataset/processed/*
!dataset/processed/.gitkeep
*.parquet
*.csv
*.jsonl

# --- Model Weights, Checkpoints & Training Logs ---
checkpoints/
saved_models/
runs/
wandb/
mlruns/
logs/
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx
*.onnx.data
*.h5

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.Python
build/
dist/
*.egg-info/
.pytest_cache/
